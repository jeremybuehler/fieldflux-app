{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "/api/index" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/$1" 
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
