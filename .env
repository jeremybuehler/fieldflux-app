# Local Development Environment Variables
# This file is for local testing only - do not commit to git

# Database - Using local PostgreSQL for testing
# If you don't have PostgreSQL installed, you can use Docker:
# docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=fieldflux postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldflux

# Session secret for development
SESSION_SECRET=local-dev-secret-key-change-in-production

# OpenAI API Key (optional for testing endpoints)
OPENAI_API_KEY=sk-test-key-placeholder

# Twilio (optional for testing SMS endpoints)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Google Analytics (optional)
# VITE_GA_MEASUREMENT_ID=

# Node environment
NODE_ENV=development
