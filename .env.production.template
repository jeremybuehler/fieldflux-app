# FieldFlux Production Environment Variables Template
# =====================================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit actual production values to version control

# =============================================================================
# 🚨 CRITICAL SECURITY SETTINGS - REQUIRED FOR PRODUCTION
# =============================================================================

# Node Environment (MUST be 'production')
NODE_ENV=production

# 🔐 AUTHENTICATION - MANDATORY FOR PRODUCTION
# Choose ONE authentication method:

# Option 1: Generic OIDC Provider (Recommended)
OIDC_ISSUER_URL=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_CALLBACK_URL=https://your-domain.com/api/callback

# Option 2: Replit Auth (if deploying on Replit)
# REPLIT_DOMAINS=your-replit-domain

# 🔒 SESSION SECURITY
SESSION_SECRET=your-secure-session-secret-min-32-chars

# 🚨 SECURITY FLAGS - CRITICAL
DISABLE_AUTH=false
DEMO_MODE=false

# =============================================================================
# 💾 DATABASE CONFIGURATION - REQUIRED
# =============================================================================

DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# =============================================================================
# 🤖 AI INTEGRATION - REQUIRED FOR CORE FEATURES
# =============================================================================

# OpenAI API (Required for content generation)
OPENAI_API_KEY=sk-your-openai-api-key

# =============================================================================
# 📊 GOOGLE SERVICES INTEGRATION - RECOMMENDED
# =============================================================================

# Google Analytics (Optional but recommended)
GOOGLE_ANALYTICS_PROPERTY_ID=GA_MEASUREMENT_ID
VITE_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# Google Places API (Optional - for review management)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Search Console (Optional - for SEO features)
GOOGLE_SEARCH_CONSOLE_PROPERTY_ID=your-property-id

# =============================================================================
# 📱 COMMUNICATION SERVICES - OPTIONAL
# =============================================================================

# Twilio SMS (Optional - for customer communication)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# SendGrid (Optional - for email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key

# =============================================================================
# 💳 PAYMENT PROCESSING - OPTIONAL
# =============================================================================

# Stripe (Optional - for subscription management)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
VITE_STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key

# =============================================================================
# 🎨 CLIENT-SIDE VARIABLES (Exposed to Frontend)
# =============================================================================
# Note: VITE_ prefixed variables are exposed to the client bundle
# Never put sensitive information in VITE_ variables

VITE_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID
VITE_STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
VITE_APP_NAME=FieldFlux
VITE_APP_VERSION=1.0.0

# =============================================================================
# ☁️ AZURE DEPLOYMENT (if using Azure)
# =============================================================================

# Azure Application Insights (Optional - for monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# Azure Storage (Optional - for file uploads)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
AZURE_STORAGE_CONTAINER_NAME=fieldflux-uploads

# =============================================================================
# 🔧 PERFORMANCE & MONITORING - RECOMMENDED
# =============================================================================

# API Rate Limiting
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=900000

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=20000

# Cache Settings
REDIS_URL=redis://username:password@host:6379
CACHE_TTL_SECONDS=3600

# =============================================================================
# 📝 LOGGING & MONITORING - RECOMMENDED
# =============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Error Reporting (Optional)
SENTRY_DSN=your-sentry-dsn

# =============================================================================
# 🔒 SECURITY HEADERS - RECOMMENDED
# =============================================================================

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=https://your-domain.com,https://your-subdomain.com

# Content Security Policy
CSP_REPORT_URI=https://your-domain.com/api/csp-report

# =============================================================================
# 🎯 FEATURE FLAGS - OPTIONAL
# =============================================================================

# Enable/disable specific features
FEATURE_FELIX_AI=true
FEATURE_SOCIAL_MEDIA_POSTING=true
FEATURE_REVIEW_MANAGEMENT=true
FEATURE_WORDPRESS_INTEGRATION=true
FEATURE_ANALYTICS_DASHBOARD=true

# =============================================================================
# 📧 EMAIL CONFIGURATION - OPTIONAL
# =============================================================================

# Email service configuration
EMAIL_PROVIDER=sendgrid
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_NAME=FieldFlux

# =============================================================================
# 🗂️ FILE UPLOAD CONFIGURATION - OPTIONAL
# =============================================================================

# Maximum file sizes (in bytes)
MAX_FILE_SIZE=10485760  # 10MB
MAX_IMAGE_SIZE=5242880  # 5MB

# Allowed file types
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# =============================================================================
# 🧪 TESTING & DEVELOPMENT - OPTIONAL
# =============================================================================

# Test database (if running tests in production environment)
TEST_DATABASE_URL=postgresql://username:password@host:5432/test_database

# =============================================================================
# 📦 DEPLOYMENT CONFIGURATION - OPTIONAL
# =============================================================================

# Application settings
PORT=5000
HOST=0.0.0.0

# Health check settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/api/health

# =============================================================================
# IMPORTANT SECURITY NOTES:
# =============================================================================
# 
# 1. Generate secure secrets:
#    - SESSION_SECRET: openssl rand -hex 32
#    - API keys: Use official provider documentation
#
# 2. Database security:
#    - Always use SSL/TLS (sslmode=require)
#    - Use strong passwords
#    - Restrict network access
#
# 3. Environment variable security:
#    - Never commit .env files to version control
#    - Use your hosting provider's secrets management
#    - Rotate secrets regularly
#    - Monitor for unauthorized access
#
# 4. Required for production deployment:
#    - NODE_ENV=production
#    - DISABLE_AUTH=false
#    - DEMO_MODE=false
#    - Valid OIDC configuration
#    - Secure DATABASE_URL
#    - OPENAI_API_KEY (for core AI features)
#
# =============================================================================
