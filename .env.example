# FieldPulse Marketing Platform Environment Variables

# Database Configuration (Required) - PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/fieldpulse_db

# Azure PostgreSQL example:
# DATABASE_URL=postgresql://username:password@your-server.postgres.database.azure.com:5432/fieldpulse_db?sslmode=require

# OpenAI Configuration (Required for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Google Analytics Configuration (Optional)
GOOGLE_ANALYTICS_PROPERTY_ID=your-ga-property-id

# Google Places API Configuration (Optional)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Replit Auth Configuration (Optional - for Replit deployment)
REPLIT_DB_URL=your-replit-db-url

# Client Environment Variables (prefix with VITE_)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Generic OIDC (Optional - for Auth0/Okta/Google, etc.)
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_CALLBACK_URL=https://your-domain.com/api/callback
SESSION_SECRET=replace-me
